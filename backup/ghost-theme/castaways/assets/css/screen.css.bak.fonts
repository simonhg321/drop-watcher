@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Share+Tech+Mono&family=Crimson+Pro:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --black: #0a0a0a;
  --abyss: #111;
  --steel: #1c1c1c;
  --iron: #2a2a2a;
  --gunmetal: #333;
  --ember: #c0392b;
  --flame: #e67e22;
  --burn: #d35400;
  --glow: rgba(230, 126, 34, 0.15);
  --ash: #777;
  --smoke: #999;
  --silver: #ccc;
  --bone: #ddd;
  --white: #f0f0f0;
}

html { scroll-behavior: smooth; }

body {
  background-color: var(--black);
  color: var(--white);
  font-family: 'Share Tech Mono', monospace;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  line-height: 1.6;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 1000;
  opacity: 0.35;
}

::selection {
  background: var(--ember);
  color: var(--white);
}

a { color: var(--flame); text-decoration: none; transition: color 0.2s ease; }
a:hover { color: var(--burn); }

/* ── READING PROGRESS BAR ────────────────────────────── */

.reading-progress {
  position: fixed;
  top: 0;
  left: 0;
  width: 0%;
  height: 2px;
  background: linear-gradient(90deg, var(--ember), var(--flame));
  z-index: 9999;
  transition: width 0.1s linear;
  box-shadow: 0 0 8px var(--ember);
}

/* ── HEADER ──────────────────────────────────────────── */

.site-header {
  padding: 1.2rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 900;
  background: rgba(10, 10, 10, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--iron);
}

.site-header::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent 0%, var(--ember) 20%, var(--flame) 50%, var(--ember) 80%, transparent 100%);
  animation: flamePulse 4s ease-in-out infinite;
}

@keyframes flamePulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.site-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.5rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.site-title a {
  color: var(--white);
  background: linear-gradient(135deg, var(--white) 0%, var(--smoke) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.site-title a:hover {
  background: linear-gradient(135deg, var(--flame) 0%, var(--ember) 100%);
  -webkit-background-clip: text;
  background-clip: text;
}

.site-nav {
  display: flex;
  gap: 1.8rem;
  align-items: center;
}

.site-nav a {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--ash);
  transition: all 0.2s ease;
  position: relative;
  padding-bottom: 2px;
}

.site-nav a:hover { color: var(--white); }

.site-nav a::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--ember);
  transition: width 0.25s ease;
}

.site-nav a:hover::after { width: 100%; }

/* ── MAIN ────────────────────────────────────────────── */

.site-main {
  max-width: 740px;
  margin: 0 auto;
  padding: 2.5rem 2rem 4rem;
}

/* ── POST FEED ───────────────────────────────────────── */

.post-feed {
  display: flex;
  flex-direction: column;
}

/* ── HERO (first post) ───────────────────────────────── */

.post-card:first-child {
  padding: 1.8rem;
  margin-bottom: 1rem;
  border: 1px solid var(--iron);
  border-left: 3px solid var(--ember);
  background: linear-gradient(135deg, var(--abyss) 0%, rgba(192, 57, 43, 0.04) 100%);
  transition: all 0.3s ease;
}

.post-card:first-child:hover {
  border-left-color: var(--flame);
  background: linear-gradient(135deg, var(--abyss) 0%, rgba(230, 126, 34, 0.06) 100%);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4), 0 0 40px rgba(192, 57, 43, 0.05);
}

.post-card:first-child .post-card-title {
  font-size: 1.7rem;
}

.post-card:first-child .post-card-excerpt {
  -webkit-line-clamp: 3;
  font-size: 0.95rem;
}

.post-card:first-child .post-card-meta::before {
  content: 'LATEST';
  color: var(--ember);
  font-weight: bold;
  letter-spacing: 0.2em;
  margin-right: 0.5rem;
}

/* ── POST CARD ───────────────────────────────────────── */

.post-card {
  padding: 1.3rem 0;
  border-bottom: 1px solid var(--iron);
  transition: all 0.2s ease;
  animation: fadeUp 0.4s ease both;
}

.post-card:nth-child(1) { animation-delay: 0s; }
.post-card:nth-child(2) { animation-delay: 0.04s; }
.post-card:nth-child(3) { animation-delay: 0.08s; }
.post-card:nth-child(4) { animation-delay: 0.12s; }
.post-card:nth-child(5) { animation-delay: 0.16s; }
.post-card:nth-child(6) { animation-delay: 0.2s; }
.post-card:nth-child(7) { animation-delay: 0.24s; }
.post-card:nth-child(8) { animation-delay: 0.28s; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

.post-card:hover { border-bottom-color: var(--gunmetal); }

.post-card-link {
  display: block;
  color: var(--white);
}

.post-card-link:hover { color: var(--white); }
.post-card-link:hover .post-card-title { color: var(--flame); }

.post-card-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.25rem;
  letter-spacing: 0.06em;
  color: var(--white);
  margin-bottom: 0.25rem;
  transition: color 0.2s ease;
  line-height: 1.15;
}

.post-card-excerpt {
  font-family: 'Crimson Pro', serif;
  font-size: 0.9rem;
  color: var(--smoke);
  line-height: 1.5;
  margin-bottom: 0.4rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-card-meta {
  font-size: 0.6rem;
  color: var(--ash);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  display: flex;
  gap: 0.8rem;
  align-items: center;
  flex-wrap: wrap;
}

.post-card-meta .sep { color: var(--iron); }

/* ── TAG PILLS ───────────────────────────────────────── */

.post-card-tag {
  display: inline-block;
  font-size: 0.55rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--ember);
  border: 1px solid rgba(192, 57, 43, 0.3);
  padding: 0.15rem 0.5rem;
  border-radius: 2px;
  transition: all 0.2s ease;
}

.post-card:hover .post-card-tag {
  border-color: var(--ember);
  background: rgba(192, 57, 43, 0.1);
}

/* ── SINGLE POST ─────────────────────────────────────── */

.post-full {
  padding-bottom: 3rem;
  animation: fadeUp 0.5s ease both;
}

.post-full-header {
  margin-bottom: 2.5rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--iron);
  position: relative;
}

.post-full-header::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 80px;
  height: 2px;
  background: linear-gradient(90deg, var(--ember), var(--flame), transparent);
}

.post-full-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 2.6rem;
  letter-spacing: 0.06em;
  color: var(--white);
  line-height: 1.08;
  margin-bottom: 0.8rem;
  background: linear-gradient(135deg, var(--white) 0%, var(--silver) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.post-full-meta {
  font-size: 0.65rem;
  color: var(--ash);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.post-full-meta .sep { color: var(--iron); }

.post-full-tag {
  display: inline-block;
  font-size: 0.55rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--ember);
  border: 1px solid rgba(192, 57, 43, 0.3);
  padding: 0.12rem 0.45rem;
  border-radius: 2px;
}

/* ── AUTHOR BYLINE ───────────────────────────────────── */

.post-full-byline {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--iron);
}

.post-full-byline-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1px solid var(--iron);
  object-fit: cover;
}

.post-full-byline-name {
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--smoke);
}

.post-full-byline-name a { color: var(--smoke); }
.post-full-byline-name a:hover { color: var(--flame); }

/* ── KOENIG EDITOR ───────────────────────────────────── */

.kg-width-wide {
  max-width: 1040px;
  margin-left: auto;
  margin-right: auto;
}

.kg-width-full {
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
}

.kg-width-wide img,
.kg-width-full img {
  width: 100%;
}

/* ── POST CONTENT ────────────────────────────────────── */

.post-full-content {
  font-family: 'Crimson Pro', serif;
  font-size: 1.13rem;
  font-weight: 400;
  line-height: 1.85;
  color: var(--white);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

.post-full-content h1,
.post-full-content h2,
.post-full-content h3,
.post-full-content h4 {
  font-family: 'Bebas Neue', sans-serif;
  color: var(--white);
  letter-spacing: 0.05em;
  margin-top: 2.5rem;
  margin-bottom: 0.7rem;
  line-height: 1.15;
}

.post-full-content h1 { font-size: 1.8rem; }

.post-full-content h2 {
  font-size: 1.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--iron);
  position: relative;
}

.post-full-content h2::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 40px;
  height: 1px;
  background: var(--ember);
}

.post-full-content h3 { font-size: 1.2rem; color: var(--bone); }
.post-full-content h4 { font-size: 1rem; color: var(--smoke); }

.post-full-content p { margin-bottom: 1.3rem; }

.post-full-content strong { color: var(--white); font-weight: 600; }

.post-full-content em { color: var(--bone); font-style: italic; }

.post-full-content ul, .post-full-content ol {
  margin-bottom: 1.3rem;
  padding-left: 1.3rem;
}

.post-full-content li { margin-bottom: 0.35rem; }

.post-full-content li::marker { color: var(--ember); }

.post-full-content blockquote {
  border-left: 3px solid var(--ember);
  padding: 1rem 1.4rem;
  margin: 1.8rem 0;
  background: linear-gradient(135deg, var(--abyss) 0%, rgba(192, 57, 43, 0.04) 100%);
  color: var(--silver);
  font-style: italic;
  position: relative;
}

.post-full-content blockquote::before {
  content: '\201C';
  position: absolute;
  top: -0.2rem;
  left: 0.5rem;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 3rem;
  color: rgba(192, 57, 43, 0.15);
  line-height: 1;
}

.post-full-content pre {
  background: var(--abyss);
  border: 1px solid var(--iron);
  border-left: 3px solid var(--ember);
  border-radius: 2px;
  padding: 1.2rem 1.4rem;
  overflow-x: auto;
  margin: 1.8rem 0;
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.8rem;
  color: var(--bone);
  line-height: 1.6;
  position: relative;
}

.post-full-content pre::before {
  content: '>';
  position: absolute;
  top: 0.4rem;
  right: 0.8rem;
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.6rem;
  color: var(--gunmetal);
  letter-spacing: 0.1em;
}

.post-full-content code {
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.82em;
  background: var(--steel);
  padding: 0.15rem 0.45rem;
  border-radius: 2px;
  color: var(--flame);
}

.post-full-content pre code {
  background: none;
  padding: 0;
  color: var(--bone);
  font-size: 1em;
}

.post-full-content hr {
  border: none;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--ember), var(--iron), transparent);
  margin: 3rem 0;
}

.post-full-content table {
  width: 100%;
  border-collapse: collapse;
  margin: 1.8rem 0;
  font-family: 'Share Tech Mono', monospace;
  font-size: 0.75rem;
}

.post-full-content th {
  text-align: left;
  padding: 0.6rem 0.7rem;
  border-bottom: 2px solid var(--ember);
  color: var(--white);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.65rem;
}

.post-full-content td {
  padding: 0.55rem 0.7rem;
  border-bottom: 1px solid var(--iron);
  color: var(--silver);
}

.post-full-content tr:hover td {
  background: var(--abyss);
}

.post-full-content img {
  max-width: 100%;
  height: auto;
  border-radius: 2px;
  margin: 2rem 0;
  border: 1px solid var(--iron);
  transition: border-color 0.3s ease;
}

.post-full-content img:hover {
  border-color: var(--gunmetal);
}

.post-full-content a {
  color: var(--flame);
  text-decoration: none;
  border-bottom: 1px solid rgba(230, 126, 34, 0.3);
  transition: border-color 0.2s ease;
}

.post-full-content a:hover {
  border-bottom-color: var(--flame);
}

/* ── BACK LINK ───────────────────────────────────────── */

.post-back {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ash);
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--iron);
  transition: color 0.2s ease;
}

.post-back:hover { color: var(--flame); }

.post-back::before {
  content: '\2190';
  font-size: 0.8rem;
}

/* ── PAGINATION ──────────────────────────────────────── */

.pagination {
  display: flex;
  justify-content: center;
  gap: 1.5rem;
  padding: 2rem 0 0;
  border-top: 1px solid var(--iron);
  margin-top: 0.5rem;
}

.pagination a {
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ash);
  padding: 0.5rem 1.4rem;
  border: 1px solid var(--iron);
  transition: all 0.2s ease;
}

.pagination a:hover {
  color: var(--white);
  border-color: var(--ember);
  background: var(--abyss);
  box-shadow: 0 0 15px rgba(192, 57, 43, 0.1);
}

/* ── FOOTER ──────────────────────────────────────────── */

.site-footer {
  padding: 2rem 2rem;
  text-align: center;
  border-top: 1px solid var(--iron);
  font-size: 0.6rem;
  color: var(--ash);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  position: relative;
}

.site-footer::before {
  content: '';
  position: absolute;
  top: -1px;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--ember), transparent);
}

.site-footer a { color: var(--ash); }
.site-footer a:hover { color: var(--flame); }

/* ── TAG / AUTHOR PAGE ───────────────────────────────── */

.tag-header {
  margin-bottom: 2rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--iron);
  position: relative;
  animation: fadeUp 0.4s ease both;
}

.tag-header::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 50px;
  height: 2px;
  background: linear-gradient(90deg, var(--ember), var(--flame));
}

.tag-header h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.6rem;
  letter-spacing: 0.1em;
  color: var(--ember);
}

.tag-header p {
  font-family: 'Crimson Pro', serif;
  font-size: 0.9rem;
  color: var(--ash);
  margin-top: 0.3rem;
}

/* ── 404 / ERROR ─────────────────────────────────────── */

.error-page {
  text-align: center;
  padding: 8rem 2rem;
  animation: fadeUp 0.5s ease both;
}

.error-code {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 6rem;
  letter-spacing: 0.3em;
  line-height: 1;
  background: linear-gradient(135deg, var(--ember) 0%, var(--flame) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.error-message {
  font-size: 0.85rem;
  color: var(--ash);
  margin-top: 0.8rem;
  letter-spacing: 0.1em;
}

.error-link {
  display: inline-block;
  margin-top: 2rem;
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ash);
  border: 1px solid var(--iron);
  padding: 0.5rem 1.8rem;
  transition: all 0.2s ease;
}

.error-link:hover {
  color: var(--white);
  border-color: var(--ember);
  background: var(--abyss);
  box-shadow: 0 0 20px rgba(192, 57, 43, 0.1);
}

/* ── SCROLLBAR ───────────────────────────────────────── */

::-webkit-scrollbar { width: 5px; }
::-webkit-scrollbar-track { background: var(--black); }
::-webkit-scrollbar-thumb { background: var(--iron); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--ember); }

/* ── COMMENTS ────────────────────────────────────────── */

.post-comments {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--iron);
}

.gh-comments,
.ghost-comments {
  --ghost-accent-color: var(--ember);
}

.post-comments iframe {
  color-scheme: dark;
}

/* ── RESPONSIVE ──────────────────────────────────────── */

@media (max-width: 640px) {
  .site-header {
    padding: 1rem 1.2rem;
    flex-direction: column;
    gap: 0.6rem;
  }
  .site-nav { gap: 1.2rem; flex-wrap: wrap; justify-content: center; }
  .site-main { padding: 1.8rem 1.2rem 3rem; }
  .post-full-title { font-size: 2rem; }
  .post-card-title { font-size: 1.1rem; }
  .post-card:first-child .post-card-title { font-size: 1.4rem; }
  .post-card:first-child { padding: 1.2rem; }
  .site-title { font-size: 1.3rem; }
  .post-full-content { font-size: 1rem; }
  .post-full-content pre { font-size: 0.72rem; padding: 0.8rem; }
  .error-code { font-size: 4rem; }
}
