#!/usr/bin/env python3
"""drops.mon — canary monitor for the matching pipeline.

Four known-good keyword+maker combos that SHOULD match recent drops.
Runs every 30 min via cron; exits 0 if all fire, exits 1 on failure.
On failure: logs, emails simonhg@gmail.com + simon@instockornot.club,
and writes /tmp/drops_mon_fail so other tools (watchdog, Claude) can check.
"""
import json
import sys
import os
import logging
from datetime import datetime, timedelta, timezone

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import db
import paths
from dotenv import load_dotenv
load_dotenv(paths.ENV_FILE, override=True)

from per_user_alerter import matches_for_watcher_drop, drop_searchable_text, _matcher_mode
from alerter import send_email

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [drops.mon] %(levelname)s %(message)s'
)
log = logging.getLogger(__name__)

FAIL_FLAG = '/tmp/drops_mon_fail'
ALERT_EMAILS = ['simonhg@gmail.com', 'simon@instockornot.club']
EMAIL_EVERY_HOURS = 6   # summary cadence while failing — not per 30-min run

# Rebuilt 2026-07-04 (S70). Old 6-canary set kept going stale: a canary here
# only stays green if its site produces a drop row (i.e. inventory CHANGE)
# with the keyword every 24h — listing the item isn't enough, since unchanged
# pages suppress alerts and write no drop row (Grimsmo false-red, 2026-07-04).
# These 4 were picked from 14 days of drop history: sites that drop daily,
# keywords verified present on EVERY drop-day in the window. Covers 3 fetch
# paths: plain HTML (True North), paginated walker (DLT, JT), Shopify
# products.json (KnifeJoy). Goal is proving Haiku extraction + matching work,
# not tracking any particular knife.
CANARIES = [
    {
        # Microtech is the only maker on newest-arrivals all 15/15 drop-days
        # (Hinderer gaps 3 days — that rotation killed the old DLT canary).
        "name": "Microtech @ DLT Trading",
        "watcher": {"url": "", "keywords": "Microtech", "maker": "Microtech"},
        "expect_url": "dlttrading.com/newest-arrivals",
    },
    {
        # Plain-HTML fetch path; page changes every scan, drops 14/14 days,
        # Hinderer present on all of them.
        "name": "Hinderer @ True North Knives",
        "watcher": {"url": "", "keywords": "Hinderer", "maker": "Hinderer"},
        "expect_url": "truenorthknives.com",
    },
    {
        # Dedicated Chris Reeve dealer page (paginated walker), 13/13 drop-days
        # but only ~1 drop/day with gaps past 24h (stable page → suppressed),
        # so this one gets a 48h window. The other three still catch a real
        # pipeline breakage within 24h.
        "name": "Sebenza @ JT Knives",
        "watcher": {"url": "", "keywords": "Sebenza", "maker": "Chris Reeve"},
        "expect_url": "jtknives.com",
        "hours": 48,
    },
    {
        # Shopify products.json path, 14/14 drop-days.
        "name": "Sebenza @ KnifeJoy",
        "watcher": {"url": "", "keywords": "Sebenza", "maker": "Chris Reeve"},
        "expect_url": "knifejoy.com",
    },
]


def notify_failure(failures, total, drop_count, first_fail=None):
    subject = f"[DROP MONITOR] {len(failures)}/{total} canaries FAILED"
    since = f"Failing since {first_fail}\n" if first_fail else ""
    body = (
        f"Canary check at {datetime.now(timezone.utc).isoformat()}\n"
        f"{since}"
        f"Checked {drop_count} drops (last 8h)\n\n"
        f"FAILED:\n" + "\n".join(f"  - {f}" for f in failures) + "\n\n"
        "This means Haiku extraction or keyword matching may be broken.\n"
        "Check /var/log/drop-watcher/drops_mon.log for details.\n"
        f"(Summary cadence: next email in {EMAIL_EVERY_HOURS}h if still failing.)"
    )
    html = body.replace("\n", "<br>")

    for addr in ALERT_EMAILS:
        try:
            send_email(subject, html, body, to_addr=addr)
            log.info(f"Failure alert sent to {addr}")
        except Exception as e:
            log.error(f"Failed to email {addr}: {e}")


def read_flag():
    try:
        with open(FAIL_FLAG) as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return {}


def write_flag(failures, first_fail_ts, last_email_ts):
    with open(FAIL_FLAG, 'w') as f:
        json.dump({
            "ts": datetime.now(timezone.utc).isoformat(),
            "failures": failures,
            "first_fail_ts": first_fail_ts,
            "last_email_ts": last_email_ts,
        }, f)


def clear_flag():
    try:
        os.remove(FAIL_FLAG)
    except FileNotFoundError:
        pass


DEFAULT_HOURS = 24
MAX_HOURS = max([c.get("hours", DEFAULT_HOURS) for c in CANARIES] + [DEFAULT_HOURS])


def run():
    drops = db.get_recent_drops(hours=MAX_HOURS)
    if not drops:
        log.error(f"NO DROPS in last {MAX_HOURS} hours — preflight may not be running")
        _fail(["NO DROPS AT ALL"], 0)
        return 1

    # Canaries route through matches_for_watcher_drop, which IS the DW_MATCHER
    # dispatch — so with DW_MATCHER=fts5 this run validates the fts5 path
    # (record_index/record_match); unset/blob keeps the current prod behavior.
    log.info(f"Matcher mode: {_matcher_mode()} (DW_MATCHER="
             f"{os.environ.get('DW_MATCHER', '<unset>')})")
    log.info(f"Checking {len(CANARIES)} canaries against {len(drops)} drops (last {MAX_HOURS}h)")
    failures = []

    for canary in CANARIES:
        hours = canary.get("hours", DEFAULT_HOURS)
        cutoff = (datetime.now(timezone.utc) - timedelta(hours=hours)).isoformat()
        matched_any = False
        for drop in drops:
            if (drop.get('timestamp') or '') < cutoff:
                continue
            drop_url = (drop.get('url') or '').lower()
            if canary["expect_url"] not in drop_url:
                continue
            hits = matches_for_watcher_drop(canary["watcher"], drop)
            if hits:
                matched_any = True
                log.info(f"  PASS  {canary['name']} — matched {hits}")
                break

        if not matched_any:
            failures.append(canary["name"])
            log.warning(f"  FAIL  {canary['name']} — no match in any drop")

    if failures:
        log.error(f"{len(failures)}/{len(CANARIES)} canaries FAILED: {', '.join(failures)}")
        _fail(failures, len(drops))
        return 1

    log.info(f"ALL {len(CANARIES)} canaries passed")
    clear_flag()
    return 0


def _fail(failures, drop_count):
    """Record the failure; email a summary at most every EMAIL_EVERY_HOURS."""
    now = datetime.now(timezone.utc)
    prev = read_flag()
    first_fail = prev.get('first_fail_ts') or now.isoformat()
    last_email = prev.get('last_email_ts')
    due = True
    if last_email:
        try:
            age = (now - datetime.fromisoformat(last_email)).total_seconds()
            due = age >= EMAIL_EVERY_HOURS * 3600
        except ValueError:
            pass
    if due:
        notify_failure(failures, len(CANARIES), drop_count, first_fail=first_fail)
        last_email = now.isoformat()
    else:
        log.info(f"Failure email suppressed (summary cadence {EMAIL_EVERY_HOURS}h; "
                 f"last sent {last_email})")
    write_flag(failures, first_fail, last_email)


if __name__ == "__main__":
    sys.exit(run())
